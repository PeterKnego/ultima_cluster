[Unit]
Description=ultima_cluster service (%i)
# The service attaches to the node's shared memory. It tolerates being started
# first, but stopping it AFTER the node would pull the log out from under a
# live reader — so bind its lifecycle to the node's.
After=uc2-node.service
BindsTo=uc2-node.service

[Service]
Type=simple
ExecStart=/usr/local/bin/%i --instance-dir /srv/uc2/n0 --app-id myapp
Restart=on-failure
RestartSec=1
# No archive to drain on this side: Service::stop() detaches and joins.
TimeoutStopSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
