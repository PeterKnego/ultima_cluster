+ jvm_opts=()
+ [[ -v JVM_OPTS ]]
+ [[ -n -Xms16M -Dio.aeron.benchmarks.output.directory=/opt/bench/results -Dio.aeron.benchmarks.aeron.cluster.service=external ]]
