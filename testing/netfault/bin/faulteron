#!/usr/bin/env bash
# faulteron — impairs UDP by rule on one interface of the network namespace it runs in.
#
#   faulteron attach                  load the programs and attach them at tc ingress and egress, with fq as the root
#                                     qdisc (replaces a previous attach, and with it every rule)
#   faulteron detach                  remove them and fq, which heals every rule at once
#   faulteron rule [selector] [--loss PCT] [--duplicate PCT] [--delay MS] [--jitter MS] [<port>...]
#                                     drop PCT% of matching UDP, send PCT% of the rest twice, and hold what leaves the
#                                     interface MS plus up to jitter MS (replaces that rule)
#   faulteron block [selector] [<port>...]    rule --loss 100
#   faulteron remove [selector] [<port>...]
#   faulteron stats                   one line per rule: <port> <type>, then its selector, settings and counters as
#                                     name=value
#
# A rule matches UDP to or from each port given, or any port if none is. The selector narrows it:
#   --peer ADDR     the far end — the destination going out, the source coming in — by IPv4 address or host name
#   --type T        an Aeron frame type — data, nak, sm, err, setup, rttm, res or a number — or retransmit, a DATA
#                   frame starting below what its flow already sent, or any (the default), which also matches what is
#                   not Aeron
#   --schema N      the SBE schema of a DATA frame's message; implies --type data
#   --template M    the SBE template of a DATA frame's message: an Aeron Cluster message named below, or an id in
#                   --schema, which defaults to Aeron Cluster's (111); implies --type data
# Schema and template come from a message's first fragment only. A packet goes to the most specific rule that
# matches it: a rule naming its peer before one that does not, then its destination port, its source port, any
# port, and within each retransmit, then type, schema and template, type and schema, type, any. Delay applies only
# to packets leaving the interface: to delay what reaches a member, impair the sender's interface. Jitter beyond the
# gap between packets reorders them.
#
# Needs CAP_BPF, CAP_NET_ADMIN and a mountable bpffs: run it as root on a Linux host, with FAULTERON_DEV naming the
# interface, or in a privileged container that shares the target's network namespace (docker run --privileged
# --network container:<name>). The attachment outlives this process, so each command is a separate run.
set -euo pipefail

DEV="${FAULTERON_DEV:-eth0}"
# The program installed beside this script (make install, the image), else built beside it in a checkout (make).
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OBJ="${FAULTERON_OBJ:-}"
if [[ -z "${OBJ}" ]]; then
    for OBJ in "${HERE}/../lib/faulteron/faulteron.bpf.o" "${HERE}/../build/faulteron.bpf.o"; do
        [[ -f "${OBJ}" ]] && break
    done
fi
PIN=/sys/fs/bpf/faulteron
TYPES=(pad data nak sm err setup rttm res)
ANY=65535
RETRANSMIT=65534
DATA=1
CLUSTER_SCHEMA=111
# Aeron 1.53.2's consensus messages, from io.aeron.cluster.codecs. Read through namerefs, as is TYPE_NUMBERS.
# shellcheck disable=SC2034
TEMPLATE_NAMES=(canvass-position request-vote vote new-leadership-term append-position commit-position
    catchup-position stop-catchup termination-position termination-ack backup-query backup-response
    heartbeat-request heartbeat-response standby-snapshot)
# shellcheck disable=SC2034
TEMPLATE_IDS=(50 51 52 53 54 55 56 57 75 76 77 78 79 80 81)
# fq's horizon: a packet held longer is dropped instead.
MAX_DELAY_MS=10000

die() {
    echo "faulteron: $*" >&2
    exit 1
}

detach() {
    tc qdisc del dev "${DEV}" clsact 2> /dev/null || true
    tc qdisc del dev "${DEV}" root 2> /dev/null || true
}

# Both programs come from one load, so they share the rules and flows maps. The pins are only the handles tc attaches
# by; the filters hold the programs once they are gone. fq holds each delayed packet until the departure time its
# program stamped, and its default limits of 100 packets a flow would drop what a delay holds back.
attach() {
    [[ -f "${OBJ}" ]] || die "no BPF program at ${OBJ}: run make, or set FAULTERON_OBJ"
    detach
    mountpoint -q /sys/fs/bpf || mount -t bpf bpf /sys/fs/bpf
    rm -rf "${PIN}"
    bpftool prog loadall "${OBJ}" "${PIN}" type classifier
    tc qdisc add dev "${DEV}" root fq limit 1000000 flow_limit 1000000
    tc qdisc add dev "${DEV}" clsact
    tc filter add dev "${DEV}" ingress bpf direct-action object-pinned "${PIN}/faulteron_in"
    tc filter add dev "${DEV}" egress bpf direct-action object-pinned "${PIN}/faulteron_out"
    rm -rf "${PIN}"
}

map_id() {
    local prog map
    for prog in $(bpftool -j net show dev "${DEV}" | jq -r '.[].tc[]?.id'); do
        [[ "$(bpftool -j prog show id "${prog}" | jq -r .name)" == faulteron_* ]] || continue
        for map in $(bpftool -j prog show id "${prog}" | jq -r '.map_ids[]'); do
            [[ "$(bpftool -j map show id "${map}" | jq -r .name)" == rules ]] && {
                echo "${map}"
                return
            }
        done
    done
    die "not attached to ${DEV}"
}

# lookup <name or number> <what> <names array> <numbers array> [extra name=number...]
lookup() {
    local -n names="$3" numbers="$4"
    local i pair
    for pair in "${@:5}"; do
        [[ "${pair%=*}" == "$1" ]] && {
            echo "${pair#*=}"
            return
        }
    done
    for i in "${!names[@]}"; do
        [[ "${names[i]}" == "$1" ]] && {
            echo "${numbers[i]}"
            return
        }
    done
    [[ "$1" =~ ^[0-9]+$ ]] && (($1 < RETRANSMIT)) || die "not $2: $1"
    echo "$1"
}

# name_of <number> <names array> <numbers array> [extra name=number...]
name_of() {
    local -n names="$2" numbers="$3"
    local i pair
    for pair in "${@:4}"; do
        [[ "${pair#*=}" == "$1" ]] && {
            echo "${pair%=*}"
            return
        }
    done
    for i in "${!numbers[@]}"; do
        [[ "${numbers[i]}" == "$1" ]] && {
            echo "${names[i]}"
            return
        }
    done
    echo "$1"
}

# shellcheck disable=SC2034
TYPE_NUMBERS=("${!TYPES[@]}")
type_number() { lookup "$1" "a frame type" TYPES TYPE_NUMBERS any="${ANY}" retransmit="${RETRANSMIT}"; }
type_name() { name_of "$1" TYPES TYPE_NUMBERS any="${ANY}" retransmit="${RETRANSMIT}"; }
template_number() { lookup "$1" "a template" TEMPLATE_NAMES TEMPLATE_IDS; }
template_name() { name_of "$1" TEMPLATE_NAMES TEMPLATE_IDS; }

# number <option> <value> <max>
number() {
    [[ "$2" =~ ^[0-9]+$ ]] && (($2 <= $3)) || die "$1 is a whole number, 0..$3: $2"
    echo "$2"
}

# Little-endian, as both architectures a container runs on are.
le16() { printf '%02x %02x' $(($1 & 255)) $(($1 >> 8 & 255)); }
le32() { printf '%s %s' "$(le16 $(($1 & 65535)))" "$(le16 $(($1 >> 16)))"; }

# The peer's four address bytes in network order, resolved in this network namespace.
peer_bytes() {
    local address
    address="$(getent ahostsv4 "$1" | awk 'NR == 1 { print $1 }')"
    [[ "${address}" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || die "no IPv4 address for --peer $1"
    printf '%02x %02x %02x %02x' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
}

# Resolves the selector into TYPE, SCHEMA, TEMPLATE and PEER, the last as key bytes.
selector() {
    TYPE="${ANY}"
    SCHEMA="${ANY}"
    TEMPLATE="${ANY}"
    PEER="00 00 00 00"
    [[ -n "${type}" ]] && TYPE="$(type_number "${type}")"
    [[ -n "${schema}" ]] && SCHEMA="$(number --schema "${schema}" $((ANY - 1)))"
    if [[ -n "${template}" ]]; then
        [[ -n "${schema}" ]] || SCHEMA="${CLUSTER_SCHEMA}"
        if ((SCHEMA == CLUSTER_SCHEMA)); then
            TEMPLATE="$(template_number "${template}")"
        else
            TEMPLATE="$(number --template "${template}" $((ANY - 1)))"
        fi
    fi
    if ((SCHEMA != ANY)); then
        [[ -n "${type}" ]] || TYPE="${DATA}"
        ((TYPE == DATA)) || die "--schema and --template match DATA frames only"
    fi
    [[ -n "${peer}" ]] && PEER="$(peer_bytes "${peer}")"
    return 0
}

# The port in network order, then the type, template and schema as little-endian u16s, then the peer.
rule_key() {
    printf 'hex %02x %02x %s %s %s %s' $(($1 >> 8)) $(($1 & 255)) "$(le16 "${TYPE}")" "$(le16 "${TEMPLATE}")" \
        "$(le16 "${SCHEMA}")" "${PEER}"
}

# Sets RULE_PORTS to the ports given, or to 0 — any port — if none were. Run in this shell, not a substitution, so a
# bad port stops the command before any rule changes.
rule_ports() {
    local port
    RULE_PORTS=(0)
    if ((${#ports[@]} > 0)); then
        RULE_PORTS=()
        for port in "${ports[@]}"; do
            if ! [[ "${port}" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then
                die "not a port: ${port}"
            fi
            RULE_PORTS+=("${port}")
        done
    fi
}

no_effects() {
    [[ -z "${loss}${duplicate}${delay}${jitter}" ]] || die "$1 takes only a selector and ports"
}

rule() {
    local map port value
    selector
    loss="$(number --loss "${loss:-0}" 100)"
    duplicate="$(number --duplicate "${duplicate:-0}" 100)"
    delay="$(number --delay "${delay:-0}" "${MAX_DELAY_MS}")"
    jitter="$(number --jitter "${jitter:-0}" "${MAX_DELAY_MS}")"
    ((loss + duplicate + delay + jitter > 0)) || die "rule needs --loss, --duplicate, --delay or --jitter"
    ((delay + jitter <= MAX_DELAY_MS)) || die "--delay plus --jitter exceeds ${MAX_DELAY_MS} ms"
    # The settings, then the three u64 counters, zeroed.
    value="$(le32 "${loss}") $(le32 "${duplicate}") $(le32 $((delay * 1000))) $(le32 $((jitter * 1000)))"
    value+="$(printf ' 00%.0s' {1..24})"
    rule_ports
    map="$(map_id)"
    for port in "${RULE_PORTS[@]}"; do
        # shellcheck disable=SC2046,SC2086
        bpftool map update id "${map}" key $(rule_key "${port}") value hex ${value} any
    done
}

block() {
    no_effects block
    loss=100
    rule
}

remove() {
    local map port
    no_effects remove
    selector
    rule_ports
    map="$(map_id)"
    for port in "${RULE_PORTS[@]}"; do
        # shellcheck disable=SC2046
        bpftool map delete id "${map}" key $(rule_key "${port}") 2> /dev/null || true
    done
}

# le_at <array> <offset> <length> — the little-endian number at that offset of a key-then-value byte array.
le_at() {
    local -n bytes="$1"
    local hex="" i
    for ((i = $2 + $3 - 1; i >= $2; i--)); do hex+="${bytes[i]}"; done
    echo $((16#${hex}))
}

stats() {
    local map port line schema_id template_id
    map="$(map_id)"
    bpftool -j map dump id "${map}" \
        | jq -r '.[] | .key + .value | map(ltrimstr("0x")) | join(" ")' \
        | while read -r -a b; do
            port=$((16#${b[0]}${b[1]}))
            ((port == 0)) && port=any
            line="${port} $(type_name "$(le_at b 2 2)")"
            template_id="$(le_at b 4 2)"
            schema_id="$(le_at b 6 2)"
            ((schema_id == ANY)) || line+=" schema=${schema_id}"
            if ((template_id != ANY)); then
                ((schema_id == CLUSTER_SCHEMA)) && template_id="$(template_name "${template_id}")"
                line+=" template=${template_id}"
            fi
            [[ "${b[8]}${b[9]}${b[10]}${b[11]}" == 00000000 ]] \
                || line+=" peer=$((16#${b[8]})).$((16#${b[9]})).$((16#${b[10]})).$((16#${b[11]}))"
            echo "${line} loss=$(le_at b 12 4)% duplicate=$(le_at b 16 4)%" \
                "delay=$(($(le_at b 20 4) / 1000))ms jitter=$(($(le_at b 24 4) / 1000))ms" \
                "dropped=$(le_at b 28 8) duplicated=$(le_at b 36 8) delayed=$(le_at b 44 8)"
        done
}

usage="usage: faulteron attach|detach|stats|rule [options] [<port>...]|block [selector] [<port>...]"
usage+="|remove [selector] [<port>...]"
cmd="${1:-}"
shift || true
peer="" type="" schema="" template="" loss="" duplicate="" delay="" jitter=""
ports=()
while (($# > 0)); do
    case "$1" in
        --peer | --type | --schema | --template | --loss | --duplicate | --delay | --jitter)
            printf -v "${1#--}" '%s' "${2:?$1 needs a value}"
            shift 2
            ;;
        --*) die "unknown option: $1" ;;
        *)
            ports+=("$1")
            shift
            ;;
    esac
done
case "${cmd}" in
    attach | detach | stats)
        [[ -z "${peer}${type}${schema}${template}${loss}${duplicate}${delay}${jitter}" ]] && ((${#ports[@]} == 0)) \
            || die "${cmd} takes no arguments"
        "${cmd}"
        ;;
    rule | block | remove) "${cmd}" ;;
    *) die "${usage}" ;;
esac
