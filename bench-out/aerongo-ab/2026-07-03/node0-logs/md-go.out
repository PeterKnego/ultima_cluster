+ DIR=/opt/bench/aeron-deploy/scripts
+ class_name=MediaDriver
+ log_file_name=media-driver-%p
+ '[' -d /dev/shm ']'
+ gc_log_file=/dev/shm/media-driver-%p-gc.log
+ error_log_file=/dev/shm/media-driver-%p-crash.log
+ java_options=(-Djava.net.preferIPv4Stack=true -Djava.net.preferIPv6Addresses=false -XX:+UnlockExperimentalVMOptions -XX:+TrustFinalNonStaticFields -XX:+UnlockDiagnosticVMOptions -XX:+DebugNonSafepoints -XX:+UseParallelGC -XX:ErrorFile="${error_log_file}" -Xms4G -Xmx4G -XX:+AlwaysPreTouch -XX:MaxMetaspaceSize=1G -XX:ReservedCodeCacheSize=1G -XX:+EnableDynamicAgentLoading "-Xlog:gc*,safepoint=info,arguments=info:file=${gc_log_file}:time")
+ add_opens=(--add-opens java.base/java.util.zip=ALL-UNNAMED --add-opens java.base/jdk.internal.misc=ALL-UNNAMED)
+ jvm_opts=()
+ [[ -v JVM_OPTS ]]
+ [[ -n -Xms16M ]]
+ IFS=' '
+ read -ra jvm_opts
+ unset IFS
+ classpath=
+ for jar in "$DIR/../benchmarks-all/build/libs"/*.jar
+ classpath=/opt/bench/aeron-deploy/scripts/../benchmarks-all/build/libs/benchmarks.jar
+ exec /usr/lib/jvm/java-21-openjdk-amd64/bin/java -cp /opt/bench/aeron-deploy/scripts/../benchmarks-all/build/libs/benchmarks.jar -Djava.net.preferIPv4Stack=true -Djava.net.preferIPv6Addresses=false -XX:+UnlockExperimentalVMOptions -XX:+TrustFinalNonStaticFields -XX:+UnlockDiagnosticVMOptions -XX:+DebugNonSafepoints -XX:+UseParallelGC -XX:ErrorFile=/dev/shm/media-driver-%p-crash.log -Xms4G -Xmx4G -XX:+AlwaysPreTouch -XX:MaxMetaspaceSize=1G -XX:ReservedCodeCacheSize=1G -XX:+EnableDynamicAgentLoading '-Xlog:gc*,safepoint=info,arguments=info:file=/dev/shm/media-driver-%p-gc.log:time' --add-opens java.base/java.util.zip=ALL-UNNAMED --add-opens java.base/jdk.internal.misc=ALL-UNNAMED -Xms16M io.aeron.driver.MediaDriver /opt/bench/aeron-deploy/scripts/aeron/low-latency-driver.properties /opt/bench/aeron-deploy/scripts/aeron/benchmark.properties /opt/bench/aeron-cfg/cluster.properties /opt/bench/aeron-cfg/node.properties
