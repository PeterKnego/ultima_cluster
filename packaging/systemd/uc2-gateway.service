[Unit]
Description=ultima_cluster gateway
After=uc2-node.service
BindsTo=uc2-node.service

[Service]
Type=simple
ExecStart=/usr/local/bin/uc2-gateway --config /etc/uc2/gateway.toml
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=2
TimeoutStopSec=5
KillSignal=SIGTERM
LimitNOFILE=65536

# Bound the gateway's CPU when it shares a host with its node (the supported
# topology): under cross-connection overload the edge can burn nearly every
# core and starve the node's busy-spin agents. Uncomment and size it to leave
# the node and service their cores — see
# docs/how-to/run-a-gateway.md#operating-envelope-260
# CPUQuota=200%

[Install]
WantedBy=multi-user.target
