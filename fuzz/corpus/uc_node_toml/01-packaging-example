# ultima_cluster node configuration.
#
# Install as /etc/uc2/node.toml and start with:
#     uc2-node --config /etc/uc2/node.toml
#
# Unknown keys are a startup REFUSAL, not a warning — a typo can never be
# silently ignored. Every optional field below shows its default, so a file
# stating only the required fields behaves exactly as this one does.

# ---------------------------------------------------------------- required

# This node's id. Must be unique in the cluster and must appear in [[members]]
# (or [[learners]]) below.
id = 0

# The UDP address this node binds for peer traffic.
#
# THIS MUST BE IDENTICAL TO THIS NODE'S OWN [[members]] ENTRY — the same
# concrete address, not a wildcard, not 0.0.0.0. A mismatch used to elect a
# leader whose followers never advanced commit, because datagrams arrived from
# a source address matching no member. The node now refuses to start instead.
#
# EXPOSURE: reachable to the other members and to nothing else. With
# [crypto].enabled = false this port TRUSTS THE NETWORK — nothing authenticates
# a datagram's source, and the one filter that does exist (the leader's
# membership check on a forwarded admin proposal, wire kind 16) matches on
# source ADDRESS, which is spoofable. Put this on a private subnet or a
# security group that admits only the member addresses, and/or turn on
# [crypto]. See docs/security/attack-surface.md.
bind = "10.0.0.10:9100"

# Where this node's control page, log buffer, journal, and state live.
#
# MUST be on a real disk. An instance_dir on tmpfs or ramfs makes every fsync a
# silent no-op, so the cluster appears to work and loses committed data on
# power loss — the node refuses to start on one.
instance_dir = "/srv/uc2/n0"

# Application identity. Every attaching party (service, clients) must present
# the same value, so a wrong app_id reads as "wrong cluster".
app_id = "myapp"

# Every VOTING member, including this node. Learners are listed separately.
# The cap is 8 total (voters + learners) — the size of the control page's
# per-peer band.
[[members]]
id = 0
addr = "10.0.0.10:9100"

[[members]]
id = 1
addr = "10.0.0.11:9100"

[[members]]
id = 2
addr = "10.0.0.12:9100"

# ---------------------------------------------------------------- optional

# Replicated-to but never counted: no vote, no quorum slot, no flow-control
# window. Ids must be disjoint from [[members]]. Default: none.
#
# [[learners]]
# id = 3
# addr = "10.0.0.13:9100"

# Log buffer (and retransmit buffer) capacity. Power of two. Default 64 MiB.
#
# This space is RESERVED ON DISK when the node starts, not consumed lazily —
# as are the IPC rings alongside it (~14 MiB), so a default instance dir needs
# ~78 MiB free before the node will boot, plus room for the journal. A node
# that cannot reserve it refuses to start, naming the error ("failed to start
# node 0: io: No space left on device"), rather than starting and dying later:
# these files are mmapped, and a write to a page with no block behind it is a
# SIGBUS, which kills the process outright instead of taking the fail-stop
# path. See docs/benchmarks/uc2-m11-gate-2026-08-20.md, row 3b.
# buffer_bytes = 67108864

# Largest single command payload. Default 512.
#
# A max-size frame plus its headers — and the crypto tag when encryption is on —
# must fit ONE datagram; the node does not fragment. Raising this past the MTU
# budget is a startup refusal.
# max_payload = 512

# Ingress admission budget in bytes: the append-minus-commit backpressure gate.
# Default 256 KiB.
# admission_bytes = 262144

# Randomised election timeout window. min must be < max. Defaults 150 ms/300 ms.
# election_timeout_min_ns = 150000000
# election_timeout_max_ns = 300000000

# Seed for this node's election-timeout randomness. Defaults to a per-id value.
#
# Leave it alone unless you have a reason. Identical seeds across nodes make
# every member time out at the same instant, split the vote, and livelock the
# cluster instead of electing anyone.
# seed = 0

# Journal segment size. Purge drops whole non-active segments. Default 64 MiB.
# journal_segment_bytes = 67108864

# Journal purging. ABSENT means disabled, which is the default: a node never
# purges unless this section is present AND the service publishes a snapshot
# floor. See docs/how-to/bound-journal-growth.md.
#
# [purge]
# below_snapshot_slack_bytes = 1048576

# Node-to-node wire encryption. REQUIRED (not absent-means-off): a node.toml
# must say so explicitly, one way or the other.
#
# enabled = false is cleartext, the default posture, same as every UC v2
# release before v2.6.0.
#
# enabled = true is a FLAG DAY, not a rolling change: a cluster runs
# all-encrypted or all-cleartext. Enabling it is a boot refusal if the key or
# allowlist is missing, malformed, or group/world-readable, or if either path
# is given while enabled = false (a config that LOOKS encrypted but would
# silently run cleartext is refused rather than honoured). See
# docs/how-to/encrypt-node-traffic.md.
[crypto]
enabled = false
# key_path = "/etc/uc2/node.key"
# allowlist_path = "/etc/uc2/allowlist.toml"
# rotation_interval_ns = 3600000000000   # 1 h
# rotation_bytes = 1099511627776         # 1 TiB

# TEST AND DEVELOPMENT ONLY. Permit an instance_dir on a RAM-backed filesystem.
# This never silences the warning — the node announces the override on every
# boot. Default false.
# allow_volatile_fs = false

# Structured logging. ABSENT section means level "info".
#
# [log]
# level = "info"          # error | warn | info

# The observability endpoint: /metrics (Prometheus), /healthz, /readyz.
# ABSENT means no endpoint. Bind to a loopback or private address — the
# endpoint is read-only but unauthenticated.
#
# [metrics]
# bind = "127.0.0.1:9600"

# M14a: the state-machine processes this node hosts (one process per id, all
# applying the same log). Absent ⇒ ids = [0] with fsm_lag = buffer_bytes / 4.
# The set is static and must match on every node; changing it is a restart,
# and an id may only be ADDED while the journal is intact from position 0
# (purge disabled or never fired) — a new FSM rebuilds from genesis.
# fsm_lag bounds how far any FSM may run ahead of the slowest ("lockstep" =
# one frame); it must be below buffer_bytes / 2. Every id beyond 0 reserves a
# further 5 MiB of ring files at boot (see instance-directory.md).
#
# [services]
# ids = [0]
# fsm_lag = "16MiB"

# Admin authentication: who may change cluster membership (add/remove/
# promote/demote) via uc2ctl. REQUIRED (not absent-means-off), like
# [crypto].enabled above.
#
# auth = "hmac" requires named keys below. Generate one with
# `uc2ctl gen-admin-key /etc/uc2/admin/alice.key` (writes 32 random bytes,
# mode 0600 — a group/world-readable key file is a boot refusal, the same
# rule as [crypto].key_path) and pass it to uc2ctl as
# `--admin-key /etc/uc2/admin/alice.key`. app_id is a wrong-cluster guard,
# NOT a credential — it is not a substitute for this section.
#
# auth = "none" is the pre-v2.6.0 posture: the instance directory's
# filesystem permissions are the ONLY admin boundary, and anyone who can
# write it can change cluster membership. The node prints a WARNING on every
# boot when this is set.
[admin]
auth = "hmac"
keys = [{ name = "ops-alice", key_path = "/etc/uc2/admin/alice.key" }]
request_ttl_ms = 30000   # how long a signed request stays valid; must be >= 1000
