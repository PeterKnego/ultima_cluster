target/
artifacts/
coverage/
corpus/seed-corpus/
.scratch/
# `cargo fuzz run` passes -artifact_prefix=fuzz/artifacts/<target>/, so its
# artifacts land under artifacts/ (ignored above). These patterns catch the
# other route: running a built target binary DIRECTLY out of the target dir,
# which is what you do to reproduce or time a single input. libFuzzer then
# defaults the prefix to the CWD and drops the artifact in fuzz/.
crash-*
leak-*
timeout-*
oom-*
