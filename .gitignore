# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# rustc "long type" diagnostic dumps (created at the project root during builds
# with deeply-nested generic types like openraft's TypeConfig surface)
*.long-type-*.txt

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target
/.claude/settings.local.json
/.idea/
/.private/
auto-bench-runs/

# Transient benchmark outputs. The committed baseline lives in
# bench-out/reference/; everything else under bench-out/ is per-run scratch.
/bench-out/*
!/bench-out/reference/
.claude/

# python bytecode (bench-infra scripts)
__pycache__/
*.pyc

# scripts/release_smoke.sh's default work directory (hundreds of MB of
# root-owned cluster state; .dockerignore keeps it out of the build context).
.release-smoke/

# superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/
